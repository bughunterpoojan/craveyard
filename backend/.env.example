# Django secret key (set a secure random string in production)
SECRET_KEY=craveyard-fest-echoes-2026-secret-key-super-secure

# Set to False in production
DEBUG=False

# Comma-separated or wildcard allowed hosts
ALLOWED_HOSTS=*

# Optional: Render PostgreSQL database URL (if using Render Postgres)
# DATABASE_URL=postgresql://username:password@dpg-xxxxxx.render.com/dbname

# Optional: Vercel frontend URL for CSRF origin whitelist
FRONTEND_URL=https://your-craveyard-stall.vercel.app
